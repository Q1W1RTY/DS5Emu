<Window x:Class="DSEmu.MainWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DS5Emu" Icon="Assets/DS5Emu.ico"
        Width="388" MinWidth="388" MaxWidth="388"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Inter, -apple-system, BlinkMacSystemFont, sans-serif"
        FontSize="13" Foreground="#F0F1F3"
        ResizeMode="NoResize"
>
    <Window.Resources>
        <!-- Windows Caption Buttons -->
        <Style x:Key="WindowsCloseButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5">
                            <Viewbox Width="9" Height="9" Stretch="Uniform">
                                <Canvas Width="10" Height="10">
                                    <Path x:Name="Glyph" Data="M1 1 L9 9 M9 1 L1 9" Stroke="#99FFFFFF" StrokeThickness="1.3" StrokeStartLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E81123"/>
                                <Setter TargetName="Glyph" Property="Stroke" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#BA141A"/>
                                <Setter TargetName="Glyph" Property="Stroke" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowsMinimizeButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5">
                            <Viewbox Width="9" Height="9" Stretch="Uniform">
                                <Canvas Width="10" Height="10">
                                    <Path x:Name="Glyph" Data="M0 5 L10 5" Stroke="#99FFFFFF" StrokeThickness="1.3" StrokeStartLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF"/>
                                <Setter TargetName="Glyph" Property="Stroke" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#30FFFFFF"/>
                                <Setter TargetName="Glyph" Property="Stroke" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Button Styles -->
        <Style x:Key="SegmentButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8CFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Brd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="0,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#15FFFFFF"/>
                                <Setter Property="Foreground" Value="#E5FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#35FFFFFF"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentButtonActive" TargetType="Button" BasedOn="{StaticResource SegmentButton}">
            <Setter Property="Background" Value="#2BFFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Brd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="0,5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.35"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- iOS Switch Template (Checked = #30D158 Green) -->
        <Style x:Key="IOSGreenSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="42" Height="24" CornerRadius="12" Background="#3D3D42">
                            <Canvas Width="42" Height="24">
                                <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="#FFFFFF" Canvas.Top="2" Canvas.Left="2">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1.5" Direction="270" Opacity="0.3"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Canvas>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#30D158"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(Canvas.Left)" To="20" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(Canvas.Left)" To="2" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- iOS Switch Template (Checked = #0A84FF Blue) -->
        <Style x:Key="IOSBlueSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="42" Height="24" CornerRadius="12" Background="#3D3D42">
                            <Canvas Width="42" Height="24">
                                <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="#FFFFFF" Canvas.Top="2" Canvas.Left="2">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1.5" Direction="270" Opacity="0.3"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Canvas>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#0A84FF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(Canvas.Left)" To="20" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(Canvas.Left)" To="2" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Apple Pill Buttons -->
        <Style x:Key="ApplePillButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#0FFFFFFF"/>
            <Setter Property="BorderBrush" Value="#0AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#D9FFFFFF"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1CFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF"/>
                                <Setter TargetName="Bg" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" CenterX="80" CenterY="19"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ApplePillButtonDanger" TargetType="Button" BasedOn="{StaticResource ApplePillButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16">
                            <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#25FF453A"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#50FF453A"/>
                                <Setter Property="Foreground" Value="#FF6961"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#35FF453A"/>
                                <Setter Property="Foreground" Value="#FF6961"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryActionButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#17FFFFFF"/>
            <Setter Property="BorderBrush" Value="#10FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF"/>
                                <Setter TargetName="Bg" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.985" ScaleY="0.985" CenterX="164" CenterY="18"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Row Button (for Accordion) -->
        <Style x:Key="GhostRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Utility Buttons -->
        <Style x:Key="CompactButton" TargetType="Button">
            <Setter Property="Background" Value="#1CFFFFFF"/>
            <Setter Property="Foreground" Value="#E5FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2CFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8CFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                            <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" CornerRadius="2" Background="#55FFFFFF"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#99FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

    <!-- Outer shadow wrapper -->
    <Grid Margin="16">
        <!-- Apple Popover Window Frame -->
        <Border Width="356" CornerRadius="28" Background="#EE18181B" BorderBrush="#26FFFFFF" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="10" Direction="270" Color="#000000" Opacity="0.75"/>
            </Border.Effect>
            <!-- Inner Specular Highlight Border -->
            <Border CornerRadius="27" BorderBrush="#14FFFFFF" BorderThickness="1,1,0,0" Padding="14">
                <StackPanel>
                    <!-- 1. Header (Windows window controls replacing macOS dots) -->
                    <Grid x:Name="DragHeader" Background="Transparent" Margin="2,0,2,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Title on Left -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="DS5Emu" FontSize="13" FontWeight="SemiBold" Foreground="#E5FFFFFF"/>
                        </StackPanel>

                        <!-- Right Controls: Status / Latency badge + Windows caption buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Live Bluetooth / Latency Pill -->
                            <Border x:Name="StatusBadge" CornerRadius="10" Background="#10FFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" Padding="8,2.5" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#30D158" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="BadgeText" Text="Bluetooth · 1.2 мс" FontSize="11" FontWeight="Medium" Foreground="#99FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Windows Window Controls -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="MinimizeBtn" Style="{StaticResource WindowsMinimizeButton}" Click="MinimizeWindow" ToolTip="Свернуть"/>
                                <Button x:Name="CloseBtn" Style="{StaticResource WindowsCloseButton}" Click="CloseWindow" ToolTip="Закрыть" Margin="2,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- 2. Device Card (DualSense + Battery) -->
                    <Border CornerRadius="20" Background="#0EFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Glyph & Info -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- 48x48 Glyph Container with subtle gradient -->
                                <Border Width="48" Height="48" CornerRadius="15" BorderBrush="#15FFFFFF" BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#1AFFFFFF" Offset="0"/>
                                            <GradientStop Color="#08FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Viewbox Width="32" Height="32" Stretch="Uniform">
                                        <Canvas Width="36" Height="36">
                                            <!-- Dynamic Lightbar Glow & Path -->
                                            <Path x:Name="GlyphLightbar" Data="M12.5,11.2 C14.3,11.8 21.7,11.8 23.5,11.2" Stroke="#0A84FF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                                <Path.Effect>
                                                    <DropShadowEffect x:Name="GlyphLightbarGlow" BlurRadius="6" ShadowDepth="0" Color="#0A84FF" Opacity="0.9"/>
                                                </Path.Effect>
                                            </Path>
                                            <!-- Controller Body -->
                                            <Path Data="M10.8,11 C7.6,11 5.6,13.8 5,18.2 C4.3,23.2 5.2,26.8 7.4,27.6 C9.4,28.3 11.1,25.8 12.6,23.2 C13.3,22 14.3,21.5 15.6,21.5 H20.4 C21.7,21.5 22.7,22 23.4,23.2 C24.9,25.8 26.6,28.3 28.6,27.6 C30.8,26.8 31.7,23.2 31,18.2 C30.4,13.8 28.4,11 25.2,11 H10.8 Z" Fill="#E6FFFFFF"/>
                                            <!-- Thumbsticks and touchpad cutouts -->
                                            <Ellipse Canvas.Left="12.3" Canvas.Top="16.3" Width="3.8" Height="3.8" Fill="#1C1C1E"/>
                                            <Ellipse Canvas.Left="19.9" Canvas.Top="16.3" Width="3.8" Height="3.8" Fill="#1C1C1E"/>
                                            <Rectangle Canvas.Left="13.5" Canvas.Top="11.5" Width="9" Height="3.6" RadiusX="1.2" RadiusY="1.2" Fill="#1C1C1E"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <!-- Controller Name and Connection Status -->
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="DualSense" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock x:Name="StatusText" Text="Подключён по Bluetooth" FontSize="12" Foreground="#8CFFFFFF" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Right: Apple iOS Battery Widget -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="BatteryText" Text="85%" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <Grid VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Pill frame -->
                                            <Border Width="26" Height="13" CornerRadius="4" BorderBrush="#59FFFFFF" BorderThickness="1" Padding="1.5">
                                                <Grid x:Name="BatteryTrack">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition x:Name="BatteryFilled" Width="85*"/>
                                                        <ColumnDefinition x:Name="BatteryEmpty" Width="15*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="BatteryFill" Background="#30D158" CornerRadius="2"/>
                                                </Grid>
                                            </Border>
                                            <!-- Battery terminal cap -->
                                            <Border Width="1.5" Height="4.5" CornerRadius="0,1,1,0" Background="#59FFFFFF" VerticalAlignment="Center" Margin="1,0,0,0"/>
                                        </StackPanel>
                                        <!-- Charging Bolt Icon -->
                                        <Path x:Name="BatteryBolt" Data="M6.8,1 L2.5,6.6 H6 L5.2,11 L9.5,5.4 H6 L6.8,1 Z" Fill="White" Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path.Effect>
                                                <DropShadowEffect BlurRadius="2" ShadowDepth="1" Direction="270" Opacity="0.5"/>
                                            </Path.Effect>
                                        </Path>
                                    </Grid>
                                </StackPanel>
                                <TextBlock x:Name="BatterySubtext" Text="Заряжается" FontSize="11" FontWeight="Medium" Foreground="#30D158" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 3. Emulation Control Platter -->
                    <Border CornerRadius="20" Background="#0EFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <!-- Top Row: Icon Badge, Title, iOS Switch -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 32x32 Badge -->
                                <Border x:Name="EmuBadge" Width="32" Height="32" CornerRadius="16" Background="#0A84FF">
                                    <Border.Effect>
                                        <DropShadowEffect x:Name="EmuBadgeGlow" BlurRadius="16" ShadowDepth="0" Color="#0A84FF" Opacity="0.4"/>
                                    </Border.Effect>
                                    <Viewbox Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M12 2v14 M15 5l-3-3-3 3 M12 13 L7 9V6 M12 11 l5-3V6" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Ellipse Canvas.Left="9" Canvas.Top="16" Width="6" Height="6" Stroke="White" StrokeThickness="2.2"/>
                                            <Ellipse Canvas.Left="6" Canvas.Top="4" Width="2" Height="2" Fill="White"/>
                                            <Rectangle Canvas.Left="16" Canvas.Top="4" Width="2" Height="2" Fill="White"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="EmuTitle" Text="Эмуляция включена" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock x:Name="EmuSubtitle" Text="Виртуальный USB-контроллер · PS5" FontSize="11.5" Foreground="#8CFFFFFF" Margin="0,2,0,0"/>
                                </StackPanel>

                                <CheckBox x:Name="MainEmuSwitch" Grid.Column="2" Style="{StaticResource IOSBlueSwitch}" VerticalAlignment="Center" Click="MainEmuSwitch_Click" ToolTip="Переключить эмуляцию"/>
                            </Grid>

                            <!-- Segmented Control (Выкл / PS5 / Xbox) -->
                            <Border CornerRadius="14" Background="#50000000" BorderBrush="#0AFFFFFF" BorderThickness="1" Padding="3" Margin="0,11,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="SegmentOff" Grid.Column="0" Content="Выкл" Style="{StaticResource SegmentButton}" Click="SelectSegment_Off"/>
                                    <Button x:Name="SegmentPS5" Grid.Column="1" Content="PS5" Style="{StaticResource SegmentButtonActive}" Click="SelectSegment_PS5"/>
                                    <Button x:Name="SegmentXInput" Grid.Column="2" Content="Xbox" Style="{StaticResource SegmentButton}" Click="SelectSegment_Xbox" ToolTip="Xbox 360 / XInput"/>
                                </Grid>
                            </Border>

                            <!-- Primary Action Button -->
                            <Button x:Name="ToggleButton" Content="Выключить эмуляцию PS5" Style="{StaticResource PrimaryActionButton}" Margin="0,11,0,0" Click="ToggleBridge"/>

                            <!-- Status/Error Detail Text -->
                            <TextBlock x:Name="ControlDetail" Foreground="#E9B4A8" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
                            <Button x:Name="FixHidHideButton" Content="Исправить HidHide" Style="{StaticResource PrimaryActionButton}" Margin="0,8,0,0" Click="FixHidHide" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. Quick Action Buttons (Переподключить / Отключить) -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="ReconnectButton" Grid.Column="0" Style="{StaticResource ApplePillButton}" Click="ReconnectBridge">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0">
                                    <Canvas Width="24" Height="24" RenderTransformOrigin="0.5,0.5">
                                        <Canvas.RenderTransform>
                                            <RotateTransform x:Name="ReconnectRotation" Angle="0" CenterX="12" CenterY="12"/>
                                        </Canvas.RenderTransform>
                                        <Path Data="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" Stroke="#D9FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Path Data="M3 3v5h5" Stroke="#D9FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Path Data="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16" Stroke="#D9FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Path Data="M16 16h5v5" Stroke="#D9FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Переподключить" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="DisconnectButton" Grid.Column="2" Style="{StaticResource ApplePillButtonDanger}" Click="DisconnectController">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M12 2v10" Stroke="#D9FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Path Data="M18.4 6.6a9 9 0 1 1-12.77.04" Stroke="#D9FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Отключить геймпад" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 5. Settings Platter (macOS System Settings Style) -->
                    <Border CornerRadius="20" Background="#0EFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" Margin="0,0,0,10">
                        <StackPanel>
                            <!-- Startup Row -->
                            <Grid Height="44" Margin="14,0">
                                <TextBlock Text="Запускать с Windows" FontSize="13" Foreground="#F0F1F3" VerticalAlignment="Center"/>
                                <CheckBox x:Name="StartupSwitch" Style="{StaticResource IOSGreenSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Background="#0FFFFFFF"/>

                            <!-- Disclosure Header Row -->
                            <Button x:Name="AdvancedButton" Style="{StaticResource GhostRowButton}" Click="ToggleAdvanced" Height="44" Padding="14,0">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Диагностика" FontSize="13" Foreground="#F0F1F3" VerticalAlignment="Center"/>

                                    </StackPanel>
                                    <Viewbox Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="DisclosureChevron" Data="M6 9 L12 15 L18 9" Stroke="#73FFFFFF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform x:Name="ChevronRotation" Angle="0" CenterX="12" CenterY="12"/>
                                                </Path.RenderTransform>
                                            </Path>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </Button>

                            <!-- Disclosure Expanded Content -->
                            <Border x:Name="DisclosurePanel" Visibility="Collapsed" Background="Transparent" BorderBrush="#0DFFFFFF" BorderThickness="0,1,0,0" Padding="14,12" CornerRadius="0,0,20,20">
                                <StackPanel>
                                    <!-- Diagnostics & Logging Section -->
                                    <Border x:Name="DiagnosticsPanel">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="Подключение и звук" FontSize="12" FontWeight="Medium" Foreground="#BBFFFFFF"/>
                                                <TextBlock x:Name="DiagnosticsUpdated" FontSize="10" Foreground="#55FFFFFF" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <!-- Metrics Columns -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel x:Name="ConnectionMetrics"/>
                                                <StackPanel Grid.Column="2" x:Name="AudioMetrics"/>
                                            </Grid>
                                            <TextBlock x:Name="DiagnosticError" Foreground="#E9B4A8" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
                                            <Border Height="1" Background="#0DFFFFFF" Margin="0,2,0,12"/>
                                            <TextBlock Text="Последние события" FontSize="12" FontWeight="Medium" Foreground="#BBFFFFFF" Margin="0,0,0,8"/>
                                            <TextBlock x:Name="EventsEmpty" Text="Событий пока нет" FontSize="11" Foreground="#66FFFFFF" Margin="0,0,0,10"/>
                                            <ItemsControl x:Name="EventList" AutomationProperties.Name="Последние события службы">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#07FFFFFF" CornerRadius="10" Padding="10,8" Margin="0,0,0,5" ToolTip="{Binding Detail}">
                                                            <StackPanel>
                                                                <Grid Margin="0,0,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="10"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Ellipse Width="5" Height="5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                        <Ellipse.Style>
                                                                            <Style TargetType="Ellipse">
                                                                                <Setter Property="Fill" Value="#6B9ECE"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Level}" Value="WARN"><Setter Property="Fill" Value="#FFB340"/></DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Level}" Value="ERROR"><Setter Property="Fill" Value="#FF7069"/></DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Ellipse.Style>
                                                                    </Ellipse>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="10" Foreground="#88FFFFFF"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding RepeatLabel}" FontSize="10" Foreground="#66FFFFFF" Margin="0,0,6,0"/>
                                                                    <TextBlock Grid.Column="3" Text="{Binding Time}" FontSize="10" Foreground="#66FFFFFF"/>
                                                                </Grid>
                                                                <TextBlock Text="{Binding Message}" FontSize="11" Foreground="#D9FFFFFF" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="44"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="Подробный журнал — в диагностическом ZIP" FontSize="10" Foreground="#55FFFFFF" Margin="0,3,0,4"/>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="ExportButton" Content="Сохранить ZIP" Click="SaveDiagnostics" FontSize="11" Style="{StaticResource CompactButton}"/>
                                                <Button Grid.Column="1" Content="Открыть папку" Click="OpenDiagnosticsFolder" FontSize="11" Style="{StaticResource CompactButton}" Margin="6,0,0,0"/>
                                                <Button Grid.Column="3" Content="Выход" Click="ExitApplication" Style="{StaticResource QuietButton}"/>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button Content="Восстановить HidHide" Click="RecoverController" Style="{StaticResource CompactButton}" FontSize="10"/>
                                                <Button Content="Сменить контроллер" Click="SelectController" Style="{StaticResource CompactButton}" FontSize="10" Margin="5,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock x:Name="DiagnosticsNotice" FontSize="11" Foreground="#E5E7EB" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Hidden legacy binding targets for compatibility -->
                    <StackPanel Visibility="Collapsed">
                        <TextBlock x:Name="ConnectionText"/>
                        <TextBlock x:Name="SignalText"/>
                    </StackPanel>

                    <!-- 6. Footer Feedback & Version -->
                    <Grid Margin="4,2,4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FooterStatus" Text="DS5Emu" FontSize="11" Foreground="#66FFFFFF"/>
                        <TextBlock x:Name="VersionText" Grid.Column="1" FontSize="11" Foreground="#66FFFFFF"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
    </ScrollViewer>
</Window>