<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DSEmu.ico</ApplicationIcon>
    <AssemblyName>DS5Emu</AssemblyName>
    <RootNamespace>DSEmu</RootNamespace>
    <Product>DS5Emu</Product>
    <Title>DS5Emu</Title>
    <Version>0.1.1</Version>
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
  </PropertyGroup>
  <ItemGroup><Resource Include="Assets\DSEmu.ico" /></ItemGroup>
</Project>
