<Window x:Class="DS5Link.MainWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DS5Link"
        Title="DS5Link" Icon="Assets/DS5Link.ico"
        Width="388" MinWidth="388" MaxWidth="388"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource AppFontFamily}" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale" UseLayoutRounding="True" SnapsToDevicePixels="True" Typography.NumeralAlignment="Tabular"
        FontSize="13" Foreground="#F0F1F3"
        ResizeMode="NoResize"
>
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="AppTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource ShellScrollBar}"/></ScrollViewer.Resources>

    <!-- Outer shadow wrapper -->
    <Grid Margin="16">
        <Border Width="356" Style="{StaticResource SharedWindowShadow}"/>
        <!-- Apple Popover Window Frame -->
        <Border Width="356" Style="{StaticResource SharedWindowFrame}">
            <!-- Inner Specular Highlight Border -->
            <Border Style="{StaticResource SharedWindowHighlight}">
                <StackPanel>
                    <!-- 1. Header (Windows window controls replacing macOS dots) -->
                    <Grid x:Name="DragHeader" Background="Transparent" Margin="2,0,2,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Title on Left -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="DS5Link" FontSize="13" FontWeight="SemiBold" Foreground="#E5FFFFFF"/>
                        </StackPanel>

                        <!-- Windows caption buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Windows Window Controls -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="LanguageButton" Content="RU" Style="{StaticResource LanguageButtonStyle}" Width="34" Height="22" FontSize="11" FontWeight="Normal" Foreground="#CCFFFFFF" Margin="0,0,8,0" ToolTip="RU / EN" AutomationProperties.Name="RU / EN" Click="ToggleLanguage"/>
                                <Button x:Name="MinimizeBtn" Style="{StaticResource WindowsMinimizeButton}" Click="MinimizeWindow" ToolTip="{local:Tr Key=36c25d9ffcfd}"/>
                                <Button x:Name="CloseBtn" Style="{StaticResource WindowsCloseButton}" Click="CloseWindow" ToolTip="{local:Tr Key=a7a4033657e8}" Margin="2,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- 2. Device Card (DualSense + Battery) -->
                    <Border CornerRadius="20" Background="#0EFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Glyph & Info -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Generated DualSense artwork inside the existing device tile -->
                                <Border Width="48" Height="48" CornerRadius="15" BorderBrush="#15FFFFFF" BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#1AFFFFFF" Offset="0"/>
                                            <GradientStop Color="#08FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Image x:Name="ControllerArtwork" Width="44" Height="44" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Source><BitmapImage UriSource="Assets/DualSense-card.png" DecodePixelWidth="176"/></Image.Source>
                                    </Image>
                                </Border>
                                <!-- Controller Name and Connection Status -->
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="DualSense" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                            <!-- Connection status below the controller name -->
                            <Border x:Name="StatusBadge" CornerRadius="10" Background="#10FFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" Padding="8,2.5" Margin="0,4,0,0" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#30D158" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="BadgeText" Text="{local:Tr Key=074415c7fee7}" FontSize="11" FontWeight="Normal" Foreground="#C4FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- Right: Apple iOS Battery Widget -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="BatteryText" Text="85%" FontSize="15" FontWeight="Normal" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <Grid VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Pill frame -->
                                            <Border Width="26" Height="13" CornerRadius="4" BorderBrush="#59FFFFFF" BorderThickness="1" Padding="1.5">
                                                <Grid x:Name="BatteryTrack">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition x:Name="BatteryFilled" Width="85*"/>
                                                        <ColumnDefinition x:Name="BatteryEmpty" Width="15*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="BatteryFill" Background="#30D158" CornerRadius="2"/>
                                                </Grid>
                                            </Border>
                                            <!-- Battery terminal cap -->
                                            <Border Width="1.5" Height="4.5" CornerRadius="0,1,1,0" Background="#59FFFFFF" VerticalAlignment="Center" Margin="1,0,0,0"/>
                                        </StackPanel>
                                        <!-- Charging Bolt Icon -->
                                        <Path x:Name="BatteryBolt" Data="M6.8,1 L2.5,6.6 H6 L5.2,11 L9.5,5.4 H6 L6.8,1 Z" Fill="White" Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path.Effect>
                                                <DropShadowEffect BlurRadius="2" ShadowDepth="1" Direction="270" Opacity="0.5"/>
                                            </Path.Effect>
                                        </Path>
                                    </Grid>
                                </StackPanel>
                                <TextBlock x:Name="BatterySubtext" Text="{local:Tr Key=f14ddcab3d6d}" FontSize="11" FontWeight="Normal" Foreground="#30D158" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 3. Emulation Control Platter -->
                    <Border CornerRadius="20" Background="#0EFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <!-- Top Row: Icon Badge, Title, iOS Switch -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 32x32 Badge -->
                                <Border x:Name="EmuBadge" Width="32" Height="32" CornerRadius="16" Background="#0A84FF">
                                    <Border.Effect>
                                        <DropShadowEffect x:Name="EmuBadgeGlow" BlurRadius="16" ShadowDepth="0" Color="#0A84FF" Opacity="0.4"/>
                                    </Border.Effect>
                                    <Viewbox Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M12 2v14 M15 5l-3-3-3 3 M12 13 L7 9V6 M12 11 l5-3V6" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Ellipse Canvas.Left="9" Canvas.Top="16" Width="6" Height="6" Stroke="White" StrokeThickness="2.2"/>
                                            <Ellipse Canvas.Left="6" Canvas.Top="4" Width="2" Height="2" Fill="White"/>
                                            <Rectangle Canvas.Left="16" Canvas.Top="4" Width="2" Height="2" Fill="White"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="EmuTitle" Text="{local:Tr Key=36c85c68e9c8}" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>

                                <CheckBox x:Name="MainEmuSwitch" Grid.Column="2" Style="{StaticResource IOSBlueSwitch}" VerticalAlignment="Center" Click="MainEmuSwitch_Click" ToolTip="{local:Tr Key=6b4c199ca1e5}"/>
                            </Grid>

                            <!-- Segmented Control (Выкл / PS5 / Xbox) -->
                            <Border CornerRadius="14" Background="#50000000" BorderBrush="#0AFFFFFF" BorderThickness="1" Padding="3" Margin="0,11,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="SegmentOff" Grid.Column="0" Content="{local:Tr Key=70f71197033b}" Style="{StaticResource SegmentButton}" Click="SelectSegment_Off"/>
                                    <Button x:Name="SegmentPS5" Grid.Column="1" Content="PS5" Style="{StaticResource SegmentButtonActive}" Click="SelectSegment_PS5"/>
                                    <Button x:Name="SegmentXInput" Grid.Column="2" Content="Xbox" Style="{StaticResource SegmentButton}" Click="SelectSegment_Xbox" ToolTip="Xbox 360 / XInput"/>
                                </Grid>
                            </Border>

                            <!-- Primary Action Button -->
                            <Button x:Name="ToggleButton" Content="{local:Tr Key=5b4c74bc5e27}" Style="{StaticResource PrimaryActionButton}" Margin="0,11,0,0" Click="ToggleBridge"/>

                            <!-- Status/Error Detail Text -->
                            <Button x:Name="FixHidHideButton" Content="{local:Tr Key=c106c133023f}" Style="{StaticResource PrimaryActionButton}" Margin="0,8,0,0" Click="FixHidHide" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. Quick Action Buttons (Переподключить / Отключить) -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="ReconnectButton" Grid.Column="0" Style="{StaticResource ApplePillButton}" Click="ReconnectBridge">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="14" Height="14" Stretch="Uniform" Margin="0,0,5,0">
                                    <Canvas Width="24" Height="24" RenderTransformOrigin="0.5,0.5">
                                        <Canvas.RenderTransform>
                                            <RotateTransform x:Name="ReconnectRotation" Angle="0" CenterX="12" CenterY="12"/>
                                        </Canvas.RenderTransform>
                                        <Path Data="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" Stroke="#D9FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Path Data="M3 3v5h5" Stroke="#D9FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Path Data="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16" Stroke="#D9FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Path Data="M16 16h5v5" Stroke="#D9FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{local:Tr Key=67c06a6c012f}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="DisconnectButton" Grid.Column="2" Style="{StaticResource ApplePillButtonDanger}" Click="DisconnectController">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="14" Height="14" Stretch="Uniform" Margin="0,0,5,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M12 2v10" Stroke="#D9FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Path Data="M18.4 6.6a9 9 0 1 1-12.77.04" Stroke="#D9FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{local:Tr Key=8945e126853d}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border CornerRadius="20" Background="#0EFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" Margin="0,0,0,10">
                        <Button x:Name="InputSettingsButton" Style="{StaticResource GhostRowButton}" Click="ToggleInputSettings" Height="54" Padding="14,0">
                            <Grid><StackPanel VerticalAlignment="Center"><TextBlock Text="{local:Tr Key=ef1b6a12a28e}" Foreground="#F0F1F3"/><TextBlock Text="{local:Tr Key=82462183aa82}" FontSize="11.5" Foreground="#99FFFFFF" Margin="0,3,0,0"/></StackPanel><TextBlock Text="↗" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#B8FFFFFF" FontSize="17"/></Grid>
                        </Button>
                    </Border>

                    <!-- 5. Settings Platter (macOS System Settings Style) -->
                    <Border CornerRadius="20" Background="#0EFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" Margin="0,0,0,10">
                        <StackPanel>
                            <!-- Startup Row -->
                            <Grid Height="44" Margin="14,0">
                                <TextBlock Text="{local:Tr Key=58e294f089bd}" FontSize="13" Foreground="#F0F1F3" VerticalAlignment="Center"/>
                                <CheckBox x:Name="StartupSwitch" Style="{StaticResource IOSGreenSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Background="#0FFFFFFF"/>

                            <!-- Disclosure Header Row -->
                            <Button x:Name="AdvancedButton" Style="{StaticResource GhostRowButton}" Click="ToggleAdvanced" Height="44" Padding="14,0">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{local:Tr Key=da4da4e3527c}" FontSize="13" Foreground="#F0F1F3" VerticalAlignment="Center"/>

                                    </StackPanel>
                                    <Viewbox Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="DisclosureChevron" Data="M6 9 L12 15 L18 9" Stroke="#73FFFFFF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform x:Name="ChevronRotation" Angle="0" CenterX="12" CenterY="12"/>
                                                </Path.RenderTransform>
                                            </Path>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </Button>

                            <!-- Disclosure Expanded Content -->
                            <Border x:Name="DisclosurePanel" Visibility="Collapsed" Background="Transparent" BorderBrush="#0DFFFFFF" BorderThickness="0,1,0,0" Padding="14,12" CornerRadius="0,0,20,20">
                                <StackPanel>
                                    <!-- Diagnostics & Logging Section -->
                                    <Border x:Name="DiagnosticsPanel">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="{local:Tr Key=43a7f10a3621}" FontSize="12" FontWeight="Normal" Foreground="#BBFFFFFF"/>
                                                <TextBlock x:Name="DiagnosticsUpdated" FontSize="11" Foreground="#55FFFFFF" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <!-- Metrics Columns -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel x:Name="ConnectionMetrics"/>
                                                <StackPanel Grid.Column="2" x:Name="AudioMetrics"/>
                                            </Grid>
                                            <TextBlock x:Name="DiagnosticError" Foreground="#E9B4A8" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
                                            <Border Height="1" Background="#0DFFFFFF" Margin="0,2,0,12"/>
                                            <TextBlock Text="{local:Tr Key=18e1009d6ab9}" FontSize="11" FontWeight="Normal" Foreground="#BBFFFFFF" Margin="0,0,0,8"/>
                                            <TextBlock x:Name="EventsEmpty" Text="{local:Tr Key=3d64c6af641f}" FontSize="11" Foreground="#A8FFFFFF" Margin="0,0,0,10"/>
                                            <ItemsControl x:Name="EventList" AutomationProperties.Name="{local:Tr Key=22d6be4e5625}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#07FFFFFF" CornerRadius="10" Padding="10,8" Margin="0,0,0,5" ToolTip="{Binding Detail}">
                                                            <StackPanel>
                                                                <Grid Margin="0,0,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="10"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Ellipse Width="5" Height="5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                        <Ellipse.Style>
                                                                            <Style TargetType="Ellipse">
                                                                                <Setter Property="Fill" Value="#6B9ECE"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Level}" Value="WARN"><Setter Property="Fill" Value="#FFB340"/></DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Level}" Value="ERROR"><Setter Property="Fill" Value="#FF7069"/></DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Ellipse.Style>
                                                                    </Ellipse>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="11" Foreground="#B8FFFFFF"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding RepeatLabel}" FontSize="11" Foreground="#A8FFFFFF" Margin="0,0,6,0"/>
                                                                    <TextBlock Grid.Column="3" Text="{Binding Time}" FontSize="11" Foreground="#A8FFFFFF"/>
                                                                </Grid>
                                                                <TextBlock Text="{Binding Message}" FontSize="11" Foreground="#D9FFFFFF" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="44"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{local:Tr Key=d73f2250fc27}" FontSize="14" Foreground="#55FFFFFF" Margin="0,3,0,4"/>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="ExportButton" Content="{local:Tr Key=56147afae454}" Click="SaveDiagnostics" FontSize="14" Style="{StaticResource CompactButton}"/>
                                                <Button Grid.Column="1" Content="{local:Tr Key=cfbf342a295b}" Click="OpenDiagnosticsFolder" FontSize="14" Style="{StaticResource CompactButton}" Margin="6,0,0,0"/>
                                                <Button Grid.Column="3" Content="{local:Tr Key=75cd24c315d4}" Click="ExitApplication" Style="{StaticResource QuietButton}"/>
                                            </Grid>
                                            <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button Content="{local:Tr Key=45c6b329780b}" Click="RecoverController" Style="{StaticResource CompactButton}" FontSize="14" Margin="0,0,5,5"/>
                                                <Button Content="{local:Tr Key=04cee37027b6}" Click="SelectController" Style="{StaticResource CompactButton}" FontSize="14" Margin="0,0,0,5"/>
                                            </WrapPanel>
                                            <TextBlock x:Name="DiagnosticsNotice" FontSize="14" Foreground="#E5E7EB" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Hidden legacy binding targets for compatibility -->
                    <StackPanel Visibility="Collapsed">
                        <TextBlock x:Name="ConnectionText"/>
                        <TextBlock x:Name="SignalText"/>
                    </StackPanel>

                    <!-- 6. Footer Feedback & Version -->
                    <Grid Margin="4,2,4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FooterStatus" Text="" FontSize="11" Foreground="#66FFFFFF"/>
                        <TextBlock x:Name="VersionText" Grid.Column="1" FontSize="11" Foreground="#66FFFFFF"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
    </ScrollViewer>
</Window>
