+
+void disconnect_bluetooth_device(const std::string &address) {
+  const auto parsed=bluetooth_address_to_u64(address);
+  if(!parsed)throw std::runtime_error("Invalid Bluetooth target address");
+  BLUETOOTH_FIND_RADIO_PARAMS parameters{sizeof(parameters)};
+  HANDLE raw_radio=nullptr;
+  const auto find=BluetoothFindFirstRadio(&parameters,&raw_radio);
+  if(!find) {
+    if(!bluetooth_device_connected(address))return;
+    throw std::runtime_error("Bluetooth radio unavailable");
+  }
+  struct FindGuard {HBLUETOOTH_RADIO_FIND value;~FindGuard(){BluetoothFindRadioClose(value);}} guard{find};
+  DWORD failure=ERROR_NOT_CONNECTED;bool requested=false;
+  do {
+    UniqueHandle radio(raw_radio);
+    BLUETOOTH_DEVICE_INFO info{};info.dwSize=sizeof(info);info.Address.ullLong=*parsed;
+    if(BluetoothGetDeviceInfo(radio.get(),&info)!=ERROR_SUCCESS || !info.fConnected)continue;
+    BTH_ADDR target=*parsed;DWORD returned=0;requested=true;
+    if(!DeviceIoControl(radio.get(),IOCTL_BTH_DISCONNECT_DEVICE,&target,sizeof(target),nullptr,0,&returned,nullptr)) {
+      failure=GetLastError();continue;
+    }
+    const auto until=Clock::now()+std::chrono::seconds(5);
+    do {
+      if(!bluetooth_device_connected(address))return;
+      std::this_thread::sleep_for(std::chrono::milliseconds(50));
+    }while(Clock::now()<until);
+    failure=ERROR_TIMEOUT;
+  }while(BluetoothFindNextRadio(find,&raw_radio));
+  if(!bluetooth_device_connected(address))return;
+  throw std::runtime_error(std::string(requested?"Bluetooth disconnect failed":"Connected Bluetooth target not found")+" (Win32 "+std::to_string(failure)+")");
+}
