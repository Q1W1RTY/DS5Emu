+#include <algorithm>
+#include <nlohmann/json.hpp>
+#include "vds/ds5_protocol.h"
+
+struct Handle {
+  HANDLE value=INVALID_HANDLE_VALUE;
+  ~Handle(){if(value!=INVALID_HANDLE_VALUE && value) CloseHandle(value);}
+};
+bool transfer(HANDLE device, void* data, DWORD size, bool write, DWORD& count, DWORD timeout) {
+  Handle event{CreateEventW(nullptr,TRUE,FALSE,nullptr)};
+  OVERLAPPED operation{}; operation.hEvent=event.value;
+  BOOL ok=write?WriteFile(device,data,size,&count,&operation):ReadFile(device,data,size,&count,&operation);
+  if(!ok && GetLastError()!=ERROR_IO_PENDING) return false;
+  if(!ok && WaitForSingleObject(event.value,timeout)!=WAIT_OBJECT_0) {
+    CancelIoEx(device,&operation); GetOverlappedResult(device,&operation,&count,TRUE); return false;
+  }
+  return GetOverlappedResult(device,&operation,&count,TRUE)!=FALSE;
+}
+void send(HANDLE device, const vds_set_state_data& state) {
+  std::array<unsigned char,48> report{}; report[0]=2;
+  std::memcpy(report.data()+1,&state,sizeof(state)); DWORD written=0;
+  if(!transfer(device,report.data(),report.size(),true,written,2000) || written!=report.size())
+    throw std::runtime_error("Virtual HID output failed");
+}
+int main(int argc,char** argv) {
+  bool input_only=false,physical=false;unsigned seconds=10;
+  for(int i=1;i<argc;++i){std::string arg(argv[i]);if(arg=="--input-only")input_only=true;else if(arg=="--physical-usb"){physical=true;input_only=true;}else if(arg.rfind("--seconds=",0)==0)seconds=std::clamp(std::stoul(arg.substr(10)),1ul,120ul);else{std::cerr<<"Unknown argument\n";return 2;}}
+  Handle device;
+  vds_set_state_data reset{};
+  reset.allow_right_trigger_ffb=reset.allow_left_trigger_ffb=reset.allow_led_color=reset.allow_player_indicators=1;
+  reset.right_trigger_ffb[0]=reset.left_trigger_ffb[0]=5;
+  try {
+    GUID guid; HidD_GetHidGuid(&guid);
+    auto info=SetupDiGetClassDevsW(&guid,nullptr,nullptr,DIGCF_PRESENT|DIGCF_DEVICEINTERFACE);
+    if(info==INVALID_HANDLE_VALUE) throw std::runtime_error("HID enumeration failed");
+    for(DWORD i=0;;++i) {
+      SP_DEVICE_INTERFACE_DATA entry{sizeof(entry)};
+      if(!SetupDiEnumDeviceInterfaces(info,nullptr,&guid,i,&entry)) break;
+      DWORD size=0; SetupDiGetDeviceInterfaceDetailW(info,&entry,nullptr,0,&size,nullptr);
+      std::vector<unsigned char> storage(size);
+      if(size<sizeof(SP_DEVICE_INTERFACE_DETAIL_DATA_W)) continue;
+      auto detail=reinterpret_cast<SP_DEVICE_INTERFACE_DETAIL_DATA_W*>(storage.data()); detail->cbSize=sizeof(*detail);
+      if(!SetupDiGetDeviceInterfaceDetailW(info,&entry,detail,size,nullptr,nullptr)) continue;
+      HANDLE candidate=CreateFileW(detail->DevicePath,GENERIC_READ|GENERIC_WRITE,FILE_SHARE_READ|FILE_SHARE_WRITE,nullptr,OPEN_EXISTING,FILE_FLAG_OVERLAPPED,nullptr);
+      if(candidate==INVALID_HANDLE_VALUE) continue;
+      HIDD_ATTRIBUTES attributes{sizeof(attributes)}; wchar_t serial[128]{};
+      std::wstring path(detail->DevicePath);std::transform(path.begin(),path.end(),path.begin(),towlower);
+      const bool identity=HidD_GetSerialNumberString(candidate,serial,sizeof(serial)) && std::wstring(serial)==L"DSEmu-DualSense-Port-0";
+      const bool match=HidD_GetAttributes(candidate,&attributes) && attributes.VendorID==0x054c && attributes.ProductID==0x0ce6
+          && (physical?(!identity && path.find(L"vid_054c&pid_0ce6")!=std::wstring::npos):identity);
+      if(match) {device.value=candidate;break;}
+      CloseHandle(candidate);
+    }
+    SetupDiDestroyDeviceInfoList(info);
+    if(device.value==INVALID_HANDLE_VALUE) throw std::runtime_error("Our virtual DualSense was not found");
+    nlohmann::json firmware=nullptr;
+    std::array<unsigned char,64> feature{};feature[0]=0x20;
+    if(HidD_GetFeature(device.value,feature.data(),feature.size())) {
+      const auto le32=[&](unsigned offset){return static_cast<std::uint32_t>(feature[offset])|(static_cast<std::uint32_t>(feature[offset+1])<<8)|(static_cast<std::uint32_t>(feature[offset+2])<<16)|(static_cast<std::uint32_t>(feature[offset+3])<<24);};
+      firmware={{"hardwareVersion",le32(24)},{"firmwareVersion",le32(28)},{"updateVersion",static_cast<unsigned>(feature[44]|(feature[45]<<8))}};
+    }
+    if(!input_only)for(int color=0;color<3;++color) {
+      auto state=reset;
+      state.led_red=color==0?60:0;state.led_green=color==1?60:0;state.led_blue=color==2?60:0;
+      send(device.value,state);Sleep(800);
+    }
+    if(!input_only)for(int side=0;side<2;++side) {
+      auto state=reset;state.led_blue=40;
+      auto trigger=side==0?state.right_trigger_ffb:state.left_trigger_ffb;
+      trigger[0]=1;trigger[1]=80;trigger[2]=60; // Brief, moderate continuous resistance.
+      send(device.value,state);Sleep(3500);
+    }
+    if(!input_only)send(device.value,reset);
+    std::uint64_t reports=0,invalid=0;
+    std::set<std::array<unsigned char,6>> axes;
+    std::set<std::array<unsigned char,3>> buttons;
+    std::array<int,6> axis_min,axis_max;axis_min.fill(255);axis_max.fill(0);
+    std::array<int,3> gyro_min,gyro_max,accel_min,accel_max;gyro_min.fill(32767);accel_min.fill(32767);gyro_max.fill(-32768);accel_max.fill(-32768);
+    std::array<bool,8> dpad{};unsigned seen=0,max_contacts=0;std::uint64_t touch_samples=0;int touch_x_min=4095,touch_x_max=0,touch_y_min=4095,touch_y_max=0;
+    std::array<unsigned char,64> last{};
+    const auto deadline=GetTickCount64()+seconds*1000;
+    while(GetTickCount64()<deadline) {
+      std::array<unsigned char,64> input{};DWORD count=0;
+      if(!transfer(device.value,input.data(),input.size(),false,count,1000)) continue;
+      if(count!=64 || input[0]!=1) {++invalid;continue;}
+      ++reports;
+      last=input;
+      for(unsigned axis=0;axis<6;++axis){axis_min[axis]=std::min(axis_min[axis],static_cast<int>(input[1+axis]));axis_max[axis]=std::max(axis_max[axis],static_cast<int>(input[1+axis]));}
+      seen|=(input[8]>>4)|(input[9]<<4)|((input[10]&7)<<12);
+      if((input[8]&15)<8)dpad[input[8]&15]=true;
+      const auto s16=[&](unsigned offset){return static_cast<int>(static_cast<std::int16_t>(input[offset]|(input[offset+1]<<8)));};
+      for(unsigned axis=0;axis<3;++axis){auto gyro=s16(16+axis*2),accel=s16(22+axis*2);gyro_min[axis]=std::min(gyro_min[axis],gyro);gyro_max[axis]=std::max(gyro_max[axis],gyro);accel_min[axis]=std::min(accel_min[axis],accel);accel_max[axis]=std::max(accel_max[axis],accel);}
+      unsigned contacts=0;
+      for(unsigned point=0;point<2;++point){const auto offset=33+point*4;if(!(input[offset]&128)){++contacts;++touch_samples;const int x=input[offset+1]|((input[offset+2]&15)<<8),y=(input[offset+2]>>4)|(input[offset+3]<<4);touch_x_min=std::min(touch_x_min,x);touch_x_max=std::max(touch_x_max,x);touch_y_min=std::min(touch_y_min,y);touch_y_max=std::max(touch_y_max,y);}}
+      max_contacts=std::max(max_contacts,contacts);
+      axes.insert({input[1],input[2],input[3],input[4],input[5],input[6]});
+      buttons.insert({input[8],input[9],input[10]});
+    }
+    const char* names[]{"Square","Cross","Circle","Triangle","L1","R1","L2","R2","Create","Options","L3","R3","PS","TouchpadClick","Mute"};
+    std::vector<std::string> pressed,missing;
+    for(unsigned bit=0;bit<15;++bit)((seen&(1u<<bit))?pressed:missing).push_back(names[bit]);
+    nlohmann::json result={{"transport",physical?"physical-usb":"virtual-usb-over-bluetooth"},{"reports",reports},{"invalidReports",invalid},{"axisMin",axis_min},{"axisMax",axis_max},{"buttonsSeen",pressed},{"buttonsMissing",missing},{"dpadDirectionsSeen",dpad},{"gyroMin",gyro_min},{"gyroMax",gyro_max},{"accelMin",accel_min},{"accelMax",accel_max},{"maxTouchContacts",max_contacts},{"touchSamples",touch_samples},{"touchXRange",{touch_x_min,touch_x_max}},{"touchYRange",{touch_y_min,touch_y_max}},{"lastAxes",{last[1],last[2],last[3],last[4],last[5],last[6]}},{"firmware",firmware}};
+    std::cout<<result.dump(2)<<'\n';
+    if(!input_only)send(device.value,reset);
+    return reports?0:1;
+  } catch(const std::exception& e) {
+    if(!input_only && device.value!=INVALID_HANDLE_VALUE) {try{send(device.value,reset);}catch(...){}}
+    std::cerr<<e.what()<<'\n';return 1;
+  }
+}
diff --git a/tests/hidhide_tests.cc b/tests/hidhide_tests.cc
new file mode 100644
index 0000000..b489b03
--- /dev/null
+++ b/tests/hidhide_tests.cc
@@ -0,0 +1,52 @@
+// SPDX-License-Identifier: MIT
+#define NOMINMAX
+#include <windows.h>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+#include "platform/win32/vds_hidhide.hh"
+#include "vds_log.hh"
+#include <nlohmann/json.hpp>
+void check(bool value,const char* message){if(!value)throw std::runtime_error(message);}
+std::string read(const std::filesystem::path& path){std::ifstream s(path);return {std::istreambuf_iterator<char>(s),{}};}
+int main(int argc,char** argv) {
+  const auto temp=std::filesystem::temp_directory_path()/("dsemu-hidhide-"+std::to_string(GetCurrentProcessId()));
+  std::filesystem::create_directories(temp);
+  const auto state=temp/"state.txt";
+  const auto mock=std::filesystem::absolute(argv[0]).parent_path()/"dsemu_mock_hidhide.exe";
+  if(!std::filesystem::exists(mock)){std::cerr<<"mock backend missing\n";return 1;}
+  SetEnvironmentVariableW(L"VDS_HIDHIDE_CLI",mock.c_str());
+  SetEnvironmentVariableW(L"DSEMU_MOCK_HIDHIDE_STATE",state.c_str());
+  try {
+    vds::Logger logger((temp/"log.txt").string());
+    vds::win::hidhide::configure_recovery((temp/"recovery.json").string());
+    const auto write=[&](std::string text){std::ofstream s(state);s<<text;};
+    write("--cloak-off\n--inv-off\n--dev-hide \"HID\\TARGET\"\n");
+    {vds::win::hidhide::DeviceGuard guard("HID\\TARGET",logger);check(read(state).find("--cloak-on")!=std::string::npos,"cloak not enabled");}
+    check(read(state).find("--cloak-off")!=std::string::npos,"initial cloak state not restored");
+    check(read(state).find("--dev-hide \"HID\\TARGET\"")!=std::string::npos,"pre-existing entry removed");
+    write("--cloak-off\n--inv-off\n");
+    {vds::win::hidhide::DeviceGuard guard("HID\\TARGET",logger);}
+    check(read(state).find("--dev-hide")==std::string::npos,"own device entry left behind");
+    write("--cloak-off\n--inv-off\n--dev-hide \"HID\\OTHER\"\n");
+    const auto before=read(state);bool rejected=false;
+    try{vds::win::hidhide::DeviceGuard guard("HID\\TARGET",logger);}catch(const std::runtime_error&){rejected=true;}
+    check(rejected && read(state)==before,"unrelated devices affected by global cloak");
+    write("--cloak-off\n--inv-on\n");rejected=false;
+    try{vds::win::hidhide::DeviceGuard guard("HID\\TARGET",logger);}catch(const std::runtime_error&){rejected=true;}
+    check(rejected && read(state)=="--cloak-off\n--inv-on\n","inverse mode was changed");
+    write("--cloak-on\n--inv-off\n--dev-hide \"HID\\OTHER\"\n");
+    {vds::win::hidhide::DeviceGuard guard("HID\\TARGET",logger);}
+    check(read(state).find("--cloak-on")!=std::string::npos && read(state).find("HID\\OTHER")!=std::string::npos,"existing active configuration changed");
+    // Simulate an interrupted lease: durable intent exists, destructor did not run.
+    const auto executable=std::filesystem::absolute(argv[0]).string();
+    write("--cloak-on\n--inv-off\n--dev-hide \"HID\\TARGET\"\n--app-reg \""+executable+"\"\n");
+    {std::ofstream journal(temp/"recovery.json");journal<<nlohmann::json{{"schema",1},{"device","HID\\TARGET"},{"daemon",executable},{"hideAdded",true},{"cloakEnabled",true},{"appAdded",true}};}
+    vds::win::hidhide::recover_changes();
+    check(read(state).find("--cloak-off")!=std::string::npos && read(state).find("--dev-hide")==std::string::npos && read(state).find("--app-reg")==std::string::npos,"crash recovery did not revert owned changes");
+    check(!std::filesystem::exists(temp/"recovery.json"),"completed journal retained");
+    std::cout<<"HidHide ownership and cloak restoration tests passed\n";
+    return 0;
+  }catch(const std::exception& e){std::cerr<<e.what()<<'\n';return 1;}
+}
